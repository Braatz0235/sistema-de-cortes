# Copie este arquivo para .env e preencha o que precisar.
# `docker compose up` já lê o .env automaticamente.

# Opcional: ativa a seleção de cortes por IA (Claude). Sem essa chave, o
# sistema usa um heurístico local para escolher os melhores momentos.
ANTHROPIC_API_KEY=

# Opcional: modelo usado para escolher os cortes.
ANTHROPIC_MODEL=claude-sonnet-5

# Opcional: usa a API de transcrição da OpenAI em vez do faster-whisper
# local (sem download de modelo, custa por uso).
OPENAI_API_KEY=
OPENAI_STT_MODEL=whisper-1

# Usado apenas quando OPENAI_API_KEY NÃO está definida (modo local):
# tamanho do modelo de transcrição (tiny, base, small, medium, large-v3).
# Modelos maiores transcrevem melhor, porém mais devagar.
WHISPER_MODEL_SIZE=base
